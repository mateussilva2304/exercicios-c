#include <stdio.h>

int main(){
    int n;
    int soma = 0;
    printf("** Calculadora de Adição **\n");
    printf("Digite os números que deseja somar (0 exibe o total):   \n");
    while (1){
        printf("Digite um número:   ");
        scanf("%d", &n);
        
        if (n == 0){
            break;
        }
        soma = soma + n;
    }
    printf("A soma dos números digitados é %d.\n", soma);

    return 0;
}
